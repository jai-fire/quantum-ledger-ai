# API Configuration
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000

# Binance Configuration
REACT_APP_BINANCE_API_KEY=your_binance_api_key_here
REACT_APP_BINANCE_SECRET=your_binance_secret_here
REACT_APP_BINANCE_TESTNET=true

# Coinbase Configuration
REACT_APP_COINBASE_API_KEY=your_coinbase_api_key_here
REACT_APP_COINBASE_SECRET=your_coinbase_secret_here
REACT_APP_COINBASE_PASSPHRASE=your_coinbase_passphrase_here
REACT_APP_COINBASE_SANDBOX=true

# AI Models Configuration
REACT_APP_AI_MODELS_ENABLED=true
REACT_APP_ML_SERVER_URL=http://localhost:8000

# Trading Configuration
REACT_APP_TRADING_MODE=simulation
REACT_APP_DEFAULT_LEVERAGE=1
REACT_APP_MAX_POSITION_SIZE=1000

# UI Configuration
REACT_APP_THEME=dark
REACT_APP_CHART_PROVIDER=recharts

# Logging
REACT_APP_LOG_LEVEL=info
REACT_APP_DEBUG_MODE=false
